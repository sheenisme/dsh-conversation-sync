{
  "name": "dsh-conversation-sync",
  "version": "1.0.11",
  "description": "Import conversations into DSH from Claude Code, Codex CLI, WorkBuddy, TRAE, Antigravity, OpenCode, generic JSONL and DeepSeek exports — and keep them in sync both ways, over SSH too.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "conversation-sync",
    "session-import",
    "ssh",
    "workbuddy",
    "trae",
    "antigravity",
    "opencode",
    "conversation-import"
  ],
  "license": "MIT",
  "author": "sheenisme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sheenisme/dsh-conversation-sync.git"
  },
  "homepage": "https://github.com/sheenisme/dsh-conversation-sync#readme",
  "bugs": {
    "url": "https://github.com/sheenisme/dsh-conversation-sync/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.zh-CN.md",
    "docs/DETAIL.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "fflate": "^0.8.2",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "*",
    "ssh2": ">=1.15.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    },
    "ssh2": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "icon": "./icon.svg"
}
